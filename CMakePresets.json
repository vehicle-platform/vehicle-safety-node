{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "Host tests (native compiler, Unity + ctest, ASan + UBSan)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VEHICLE_BUILD_HOST_TESTS": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "host-coverage",
      "displayName": "Host tests with gcov line/branch coverage (no sanitizers)",
      "inherits": "host-tests",
      "binaryDir": "${sourceDir}/build/host-coverage",
      "cacheVariables": { "CMAKE_C_FLAGS": "--coverage -O0 -fprofile-update=atomic" }
    },
    {
      "name": "target-g474-debug",
      "displayName": "Cortex-M4F (STM32G474) cross build (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/target-g474-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "target-g474-release",
      "displayName": "Cortex-M4F (STM32G474) cross build (Release)",
      "inherits": "target-g474-debug",
      "binaryDir": "${sourceDir}/build/target-g474-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    }
  ],
  "buildPresets": [
    { "name": "host-tests", "configurePreset": "host-tests" },
    { "name": "host-coverage", "configurePreset": "host-coverage" },
    { "name": "target-g474-debug", "configurePreset": "target-g474-debug" },
    { "name": "target-g474-release", "configurePreset": "target-g474-release" }
  ],
  "testPresets": [
    { "name": "host-tests", "configurePreset": "host-tests", "output": { "outputOnFailure": true } },
    { "name": "host-coverage", "configurePreset": "host-coverage", "output": { "outputOnFailure": true } }
  ]
}
